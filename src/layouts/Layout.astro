---
import "@/styles/global.css";
import { Font } from "astro:assets";
import NavDesktop from "@/components/nav-desktop.astro";
import NavMobile from "@/components/nav-mobile.astro";

const ogImage = new URL("og-image.jpg", Astro.site);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-google-sans-flex" />
        <Font cssVariable="--font-instrument-serif" />
        <title>Yagnik Patel</title>
        <meta name="title" content={`Yagnik Patel`} />
        <meta
            name="description"
            content="Yagnik Patel's portfolio site showing current work and other things about him."
        />
        <meta name="author" content="Yagnik Patel" />
        <meta name="keywords" content="yagnik, yagnik patel, portfolio" />
        <meta name="robots" content="index, follow" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta property="og:title" content="Yagnik Patel" />
        <meta
            property="og:description"
            content="Yagnik Patel's portfolio site showing current work and other things about him."
        />
        <meta property="og:url" content={Astro.site} />
        <meta property="og:site_name" content="Yagnik Patel" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content={Astro.site} />
        <meta name="twitter:creator" content="@yagnik_pt" />
        <meta name="twitter:title" content="Yagnik Patel" />
        <meta
            name="twitter:description"
            content="Yagnik Patel's portfolio site showing current work and other things about him."
        />
        <meta name="twitter:image" content={ogImage} />
        <script is:inline>
            (() => {
                const normalize = (p) => p.replace(/\/$/, "") || "/";
                const getNavDirection = (from, to) => {
                    if (!from || !to) return null;
                    const f = normalize(from);
                    const t = normalize(to);
                    if (f === "/" && t === "/about") return "forward";
                    if (f === "/about" && t === "/") return "backward";
                    return null;
                };

                window.addEventListener("pageswap", (e) => {
                    if (!e.viewTransition) return;
                    let dir = null;
                    if (e.activation?.from && e.activation?.entry) {
                        try {
                            dir = getNavDirection(
                                new URL(e.activation.from.url).pathname,
                                new URL(e.activation.entry.url).pathname,
                            );
                        } catch {}
                    }
                    if (!dir) {
                        try {
                            dir = sessionStorage.getItem("nav-direction");
                        } catch {}
                    }
                    if (dir) {
                        try {
                            e.viewTransition.types.add(dir);
                        } catch {}
                        document.documentElement.dataset.navDirection = dir;
                    }
                });

                window.addEventListener("pagereveal", (e) => {
                    if (!e.viewTransition) return;
                    let dir = null;
                    if (window.navigation?.activation?.from && window.navigation?.activation?.entry) {
                        try {
                            dir = getNavDirection(
                                new URL(navigation.activation.from.url).pathname,
                                new URL(navigation.activation.entry.url).pathname,
                            );
                        } catch {}
                    }
                    if (!dir) {
                        try {
                            dir = sessionStorage.getItem("nav-direction");
                        } catch {}
                    }
                    if (dir) {
                        try {
                            e.viewTransition.types.add(dir);
                        } catch {}
                        document.documentElement.dataset.navDirection = dir;
                    }
                    e.viewTransition.finished.finally(() => {
                        try {
                            sessionStorage.removeItem("nav-direction");
                        } catch {}
                        delete document.documentElement.dataset.navDirection;
                    });
                });

                document.addEventListener(
                    "click",
                    (e) => {
                        const link = e.target?.closest?.("a[href]");
                        if (!link?.href) return;
                        try {
                            const url = new URL(link.href, window.location.href);
                            if (url.origin === window.location.origin) {
                                const dir = getNavDirection(window.location.pathname, url.pathname);
                                if (dir) {
                                    sessionStorage.setItem("nav-direction", dir);
                                    document.documentElement.dataset.navDirection = dir;
                                } else {
                                    sessionStorage.removeItem("nav-direction");
                                    delete document.documentElement.dataset.navDirection;
                                }
                            }
                        } catch {}
                    },
                    { capture: true },
                );
            })();
        </script>
    </head>
    <body>
        <div
            class="[--content-w:42rem] 2xl:[--content-w:48rem]
          grid lg:grid-cols-[1fr_var(--content-w)_1fr] w-full h-full"
        >
            <NavDesktop pathname={pathname} />
            <NavMobile pathname={pathname} />

            <slot />

            <div></div>
        </div>
    </body>
</html>
